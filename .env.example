# Cloud AI is OFF by default. App uses local heuristic feedback.
# To enable real LLM coaching later:
#   1) set a key below
#   2) set AI_COACH_ENABLED=1
#   3) restart npm run dev

AI_COACH_ENABLED=0

# Prefer Anthropic Claude when cloud is enabled.
ANTHROPIC_API_KEY=

# Fallback / alternative provider
OPENAI_API_KEY=

# anthropic | openai  (optional; auto-detects from keys if omitted)
AI_PROVIDER=
